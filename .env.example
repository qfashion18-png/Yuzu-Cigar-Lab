# Production storefront and Yuzu API.
# Production storefront: https://www.yuzucigarclub.com
NEXT_PUBLIC_BASE_URL=https://www.yuzucigarclub.com
BASE_URL=https://www.yuzucigarclub.com
NEXT_PUBLIC_AGE_VERIFICATION_VENDOR=AgeChecker.Net
NEXT_PUBLIC_TAX_PROVIDER=Stripe Tax
NEXT_PUBLIC_YCC_API_BASE_URL=https://api.yuzucigarclub.com
NEXT_PUBLIC_AGECHECKER_API_KEY=replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_replace_me
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=replace_me
NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_replace_me
NEXT_PUBLIC_COGNITO_HOSTED_UI_BASE=https://replace-me.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_PATH=/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_PATH=/auth/logout
NEXT_PUBLIC_COGNITO_SCOPES=openid email profile
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com
NEXT_PUBLIC_REQUIRE_LIVE_AUTH=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_me
STRIPE_TOBACCO_APPROVAL_CONFIRMED=false
STRIPE_TEST_MODE_E2E_CONFIRMED=false
AGE_VERIFICATION_PROVIDER_CONFIRMED=false
TAX_PROVIDER_CONFIRMED=false
ADULT_SIGNATURE_CARRIER_APPROVED=false
AWS_RESTORE_DRILL_COMPLETED=false
STAGING_BROWSER_QA_PASSED=false
WAF_OR_RATE_LIMITING_ACCEPTED=false

# Web Push alert settings. NEXT_PUBLIC_VAPID_PUBLIC_KEY and VAPID_PUBLIC_KEY
# must be the same public key from one VAPID key pair; keep the private key
# server-only in Lambda.
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:alerts@yuzucigarclub.com
HUMIDOR_ALERT_DISPATCH_SECRET=replace_me

# Production Lambda should set one of these to the commerce provider secret.
# Keep live Stripe, age, tax, and shipping credentials in Secrets Manager, not
# in the static storefront bundle.
COMMERCE_PROVIDER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:ycc/commerce/prod
COMMERCE_PROVIDER_SECRET_ID=

# Stripe server-only settings. These direct values are local/dev fallbacks when
# COMMERCE_PROVIDER_SECRET_ARN is unset.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_replace_me
STRIPE_LAUNCH_CATALOG_READY=
STRIPE_LAUNCH_CATALOG_JSON=
STRIPE_LAUNCH_CATALOG_PATH=
FEATURE_STRIPE_TAX=
STRIPE_PRICE_BOX_ACCESS_PASS_MONTHLY=price_replace_me
STRIPE_PRICE_BOX_ACCESS_PASS_QUARTERLY=price_replace_me
STRIPE_PRICE_BOX_ACCESS_PASS_YEARLY=price_replace_me
STRIPE_PRICE_KISHA_MONTHLY=price_replace_me
STRIPE_PRICE_KISHA_QUARTERLY=price_replace_me
STRIPE_PRICE_KISHA_YEARLY=price_replace_me
STRIPE_PRICE_SENSEI_MONTHLY=price_replace_me
STRIPE_PRICE_SENSEI_QUARTERLY=price_replace_me
STRIPE_PRICE_SENSEI_YEARLY=price_replace_me
STRIPE_PRICE_DAIMYO_MONTHLY=price_replace_me
STRIPE_PRICE_DAIMYO_QUARTERLY=price_replace_me
STRIPE_PRICE_DAIMYO_YEARLY=price_replace_me

# Daily automated Cigar Flow/newsroom job (CI automation).
# Prefer the Cognito service-account credentials below so each run mints a fresh token.
YCC_NEWSROOM_COGNITO_USERNAME=operator@example.com
YCC_NEWSROOM_COGNITO_PASSWORD=replace_me
# Local-only workaround if the machine cannot validate Cognito TLS certificates.
YCC_NEWSROOM_COGNITO_TLS_INSECURE=false
# Local-only workaround if the machine cannot validate the YCC API TLS certificate chain.
YCC_NEWSROOM_API_TLS_INSECURE=false
# Optional fallback for short-lived manual runs only.
YCC_NEWSROOM_BEARER_TOKEN=replace_me
YCC_DAILY_NEWSROOM_AUTO_PUBLISH=true
YCC_DAILY_NEWSROOM_SOURCE_LIMIT=3

# Cigar Flow to Facebook Page + Group kit automation.
# Page publishing can use direct env tokens or the AWS Secrets Manager secret that
# stores the Yuzu Meta system-user token/page metadata. Group posting is exported
# as a browser/manual kit because Meta removed normal Facebook Groups API publishing.
YCC_CIGAR_FLOW_SOCIAL_DATE=
YCC_CIGAR_FLOW_SOCIAL_PUBLISH_PAGE=false
YCC_CIGAR_FLOW_SOCIAL_IMAGE_LIMIT=3
YCC_FACEBOOK_GRAPH_VERSION=v25.0
YCC_FACEBOOK_SECRET_ID=ycc/social/facebook/prod
YCC_FACEBOOK_PAGE_ID=replace_me
YCC_FACEBOOK_PAGE_ACCESS_TOKEN=
YCC_FACEBOOK_SYSTEM_USER_TOKEN=

# Server-only regulated commerce providers. Store live values in Secrets Manager.
AGE_VERIFICATION_VENDOR=AgeChecker.Net
AGE_VERIFICATION_API_KEY=replace_me
AGE_VERIFICATION_API_SECRET=replace_me
AGE_VERIFICATION_SIGNING_SECRET=replace_me
TAX_PROVIDER=Stripe Tax
SHIPPING_PROVIDER=USPS
SHIPPING_ADULT_SIGNATURE_ACCOUNT_ID=replace_me
MEMBERSHIP_ENTITLEMENT_SIGNING_SECRET=replace_me
NEXT_PUBLIC_ENABLE_BACKUP_ADMIN=false

# RDS/Aurora PostgreSQL server-only settings.
# Do not expose these with NEXT_PUBLIC_.
RDS_HOST=database-1.example.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=postgres
RDS_USERNAME=postgres_user
RDS_PASSWORD=replace_me
RDS_SSLMODE=verify-full
RDS_SSLROOTCERT=./global-bundle.pem

# Server-only Bedrock agent runtime settings. Configure per environment.
FEATURE_BEDROCK=pending_agent
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_ENABLE_GUARDRAILS=1
BEDROCK_GUARDRAIL_ID=replace_me
BEDROCK_GUARDRAIL_VERSION=replace_me
BEDROCK_KNOWLEDGE_BASE_ID=replace_me
BEDROCK_AGENT_YCCCONCIERGE_ID=replace_me
BEDROCK_AGENT_YCCCONCIERGE_ALIAS_ID=replace_me
BEDROCK_AGENT_YCCCIGARGUIDE_ID=replace_me
BEDROCK_AGENT_YCCCIGARGUIDE_ALIAS_ID=replace_me
BEDROCK_AGENT_YCCSUPPORTAGENT_ID=replace_me
BEDROCK_AGENT_YCCSUPPORTAGENT_ALIAS_ID=replace_me
BEDROCK_AGENT_YCCHUMIDORAGENT_ID=replace_me
BEDROCK_AGENT_YCCHUMIDORAGENT_ALIAS_ID=replace_me
BEDROCK_AGENT_YCCADMINAGENT_ID=replace_me
BEDROCK_AGENT_YCCADMINAGENT_ALIAS_ID=replace_me
BEDROCK_AGENT_YCCNEWSAGENT_ID=replace_me
BEDROCK_AGENT_YCCNEWSAGENT_ALIAS_ID=replace_me

# Server-only support email settings.
# SES receipt events use the configured Bedrock YCCSupportAgent to draft
# operator-review replies for every inbound raw email.
FEATURE_SES=pending_production_access
SUPPORT_EMAIL_FROM=support@yuzucigarclub.com
SUPPORT_CONTACT_EMAIL_TO=support@yuzucigarclub.com
SUPPORT_EMAIL_RAW_BUCKET=replace_me
SUPPORT_EMAIL_RAW_PREFIX=ycc/support-email/raw/
# Reply-To target for subscriber brand-preference follow-up replies.
SUPPORT_EMAIL_INBOUND_RECIPIENT=support@ses-support.yuzucigarclub.com

# Server-only Lex V2 router. Set FEATURE_LEX_ROUTER=ready after creating a
# tagged YCC Lex bot alias and granting Lambda lex:RecognizeText on it.
FEATURE_LEX_ROUTER=pending_bot
LEX_ROUTER_BOT_ID=replace_me
LEX_ROUTER_BOT_ALIAS_ID=replace_me
LEX_ROUTER_LOCALE_ID=en_US

# Server-only Rekognition image understanding assist for the AI Cigar Adder
# and Humidor Agent saved-item updates.
# Use detect_text_ready for OCR only, or image_understanding_ready after Lambda
# has rekognition:DetectText and rekognition:DetectLabels permission.
FEATURE_REKOGNITION=pending_service
REKOGNITION_MIN_TEXT_CONFIDENCE=70
REKOGNITION_MIN_LABEL_CONFIDENCE=70

# Local Nova Act cigar metadata enrichment e2e. Keep the API key out of the
# static app bundle and treat outputs as review-only proposals. Use auth=iam
# for AWS-root/IAM workflow runs instead of reusing AWS secrets as API keys.
NOVA_ACT_AUTH=api-key
NOVA_ACT_API_KEY=replace_me
NOVA_ACT_WORKFLOW_DEFINITION_NAME=ycc-cigar-enrichment-e2e
NOVA_ACT_MODEL_ID=nova-act-preview
NOVA_ACT_AWS_REGION=us-east-1
NOVA_ACT_LOG_GROUP_NAME=
NOVA_ACT_IGNORE_HTTPS_ERRORS=false
NOVA_ACT_CIGAR_QUERY=Padron 1964 Anniversary Maduro Exclusivo
NOVA_ACT_CIGAR_SOURCE_URLS=https://padron.com/padron-1964-anniversary-series/
NOVA_ACT_CIGAR_E2E_OUTPUT=output/nova-act-cigar-enrichment-e2e.json
NOVA_ACT_LOGS_DIR=output/nova-act-logs
NOVA_ACT_MAX_STEPS=20
NOVA_ACT_TIMEOUT_SECONDS=180

# Server-only concierge voice settings. Transcribe handles speech-to-text; Polly handles spoken replies.
FEATURE_CONCIERGE_VOICE=pending_services
CONCIERGE_TRANSCRIBE_LANGUAGE_CODE=en-US
CONCIERGE_VOICE_BUCKET=replace_me
CONCIERGE_VOICE_PREFIX=ycc/concierge-voice/
CONCIERGE_VOICE_TRANSCRIBE_MAX_WAIT_MS=22000
CONCIERGE_POLLY_ENGINE=neural
CONCIERGE_POLLY_VOICE_ID=Joanna
