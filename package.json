    "@aws-sdk/client-lex-runtime-v2": "^3.1068.0",
    "@aws-sdk/client-polly": "^3.1068.0",
    "@aws-sdk/client-rekognition": "^3.1068.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/client-secrets-manager": "^3.1068.0",
    "@aws-sdk/client-sesv2": "^3.1068.0",
    "@aws-sdk/client-sns": "^3.1068.0",
    "@aws-sdk/client-transcribe": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
