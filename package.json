{
  "name": "yuzu-cigar-club",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/static-preview.mjs out",
    "preview": "npm run build && npm run start",
    "e2e:runtime-audit": "npm run build && tsx scripts/e2e-runtime-audit.ts",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "launch:check": "npm run lint && npx tsc --noEmit && npm test && npm run build && npm audit --omit=dev",
    "launch:ops-check": "tsx scripts/launch-readiness.ts",
    "launch:go-live-check": "tsx scripts/launch-readiness.ts --strict",
    "lambda:package": "node scripts/package-ycc-api-lambda.mjs",
    "db:check": "tsx scripts/check-rds-connection.ts",
    "cigar-flow:daily": "tsx scripts/daily-cigar-news-run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1043.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1043.0",
    "@aws-sdk/client-polly": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/client-secrets-manager": "^3.1043.0",
    "@aws-sdk/client-sesv2": "^3.1044.0",
    "@aws-sdk/client-transcribe": "^3.1045.0",
    "@base-ui/react": "^1.4.1",
    "@medusajs/js-sdk": "^2.14.2",
    "@medusajs/types": "^2.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "serve": "^14.2.6",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "hono": "4.12.18",
    "postcss": "8.5.10"
  }
