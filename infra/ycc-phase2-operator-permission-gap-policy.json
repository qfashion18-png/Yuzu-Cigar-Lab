{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowYccApiLambdaRuntimePolicyManagement",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::374587466106:role/service-role/ycyyy-1778040454500"
    },
    {
      "Sid": "AllowYccEventBusCreateAndTag",
      "Effect": "Allow",
      "Action": [
        "events:CreateEventBus",
        "events:TagResource"
      ],
      "Resource": "arn:aws:events:us-east-1:374587466106:event-bus/ycc-events"
    },
    {
      "Sid": "AllowYccApiStageTagging",
      "Effect": "Allow",
      "Action": "apigateway:TagResource",
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/13710cp67l/stages",
        "arn:aws:apigateway:us-east-1::/apis/13710cp67l/stages/*"
      ]
    }
  ]
}
