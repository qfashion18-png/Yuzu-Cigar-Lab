{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "YccHumidorIotPolicyAndRuleSetup",
      "Effect": "Allow",
      "Action": [
        "iot:CreatePolicy",
        "iot:CreatePolicyVersion",
        "iot:DeletePolicyVersion",
        "iot:GetPolicy",
        "iot:ListPolicyVersions",
        "iot:CreateTopicRule",
        "iot:GetTopicRule",
        "iot:ReplaceTopicRule",
        "iot:ListTopicRules"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:374587466106:policy/YccHumidorDeviceTelemetryPolicy",
        "arn:aws:iot:us-east-1:374587466106:rule/YccHumidorTelemetryToLambda"
      ]
    },
    {
      "Sid": "YccHumidorCertificateCreate",
      "Effect": "Allow",
      "Action": [
        "iot:CreateKeysAndCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "YccHumidorThingSetup",
      "Effect": "Allow",
      "Action": [
        "iot:CreateThing",
        "iot:DescribeThing",
        "iot:ListThings",
        "iot:CreateThingType",
        "iot:DescribeThingType",
        "iot:AttachPolicy",
        "iot:AttachThingPrincipal",
        "iot:ListThingPrincipals"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:374587466106:thing/ycc-humidor-*",
        "arn:aws:iot:us-east-1:374587466106:thingtype/YccHumidorDevice",
        "arn:aws:iot:us-east-1:374587466106:cert/*",
        "arn:aws:iot:us-east-1:374587466106:policy/YccHumidorDeviceTelemetryPolicy"
      ]
    },
    {
      "Sid": "YccHumidorIotEndpointRead",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeEndpoint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "YccHumidorIotSmokePublish",
      "Effect": "Allow",
      "Action": [
        "iot:Publish"
      ],
      "Resource": "arn:aws:iot:us-east-1:374587466106:topic/ycc/humidor/*/telemetry"
    },
    {
      "Sid": "YccHumidorLambdaInvokePermission",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:GetPolicy"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:374587466106:function:ycyyy",
        "arn:aws:lambda:us-east-1:374587466106:function:ycyyy:*"
      ]
    }
  ]
}
